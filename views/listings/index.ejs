<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN%>";
    const listings = <%- JSON.stringify(allListings)%>;
</script>

<style>
  .filters-wrapper{display:flex;align-items:center;gap:8px;margin-top:1rem}
  .filters-scroll{display:flex;gap:1.5rem;overflow-x:auto;padding:0.4rem 0.2rem;scroll-behavior:smooth;-webkit-overflow-scrolling:touch}
  .filters-scroll::-webkit-scrollbar{display:none}
  .filter{flex:0 0 auto;text-align:center;margin-top:0.6rem;opacity:0.9;transition:transform .18s,opacity .18s,box-shadow .18s;padding:0.35rem;border-radius:8px}
  .filter:hover{transform:translateY(-6px) scale(1.03);opacity:1;box-shadow:0 8px 20px rgba(0,0,0,0.12);cursor:pointer}
  .filter p{font-size:0.85rem;margin:0.25rem 0 0}
  .filter .fa{font-size:1.35rem;color:#2d6cdf}
  .filter-arrow{background:#fff;border:1px solid #e6e6e6;width:36px;height:36px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,0.06);cursor:pointer;transition:transform .12s}
  .filter-arrow:active{transform:scale(.98)}
  .filter-arrow:hover{transform:scale(1.05)}
  .filter.active-filter{background:linear-gradient(135deg,#2d6cdf,#6fb1ff);color:#fff}
  .filter.active-filter .fa{color:#fff}
  @media (max-width:576px){.filter p{font-size:0.72rem}.filter .fa{font-size:1.05rem}}


  .tax-info{
    display: none;
  }
  .form-check-input:checked {
    background-color: #fe424d;
    border-color: #fe424d;
  }
  .form-check-input:checked:focus {
    box-shadow: 0 0 0 0.25rem rgba(254, 66, 77, 0.25);
  }

  .tax-toggle{
    display:flex;
    align-items:center;
    justify-content:center;
    border: 1px solid rgb(230, 224, 224);
    border-radius: 1rem;
    height: 3.5rem;
    padding: 1rem;
    margin-left: 3rem;
  }
  .tax-toggle .form-switch{
    display:flex;
    align-items:center;
    gap:0.6rem;
    white-space:nowrap;
    flex-direction: row-reverse;
  }
  .tax-toggle .form-check-label{
    margin-bottom:0;
    white-space:nowrap;
  }

  /* Map styles */
  #map-container {
    margin: 3rem 0 2rem 0;
    padding: 1rem 0;
    background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
    border-radius: 12px;
  }

  #map {
    width: 100%;
    height: 500px;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .map-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #333;
    margin-bottom: 1rem;
    padding: 0 1rem;
  }

  .map-info {
    padding: 0 1rem;
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
</style>


<div class="filters-wrapper">
