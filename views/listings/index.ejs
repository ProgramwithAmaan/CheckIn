    </div> -->

    <!-- <div class="filter">
      <div><i class="fa-solid fa-wallet"></i></div>
      <p>Budget</p>
    </div> -->
    
    <!-- More filters to ensure arrows reveal additional options -->
    <div class="filter">
      <div><i class="fa-solid fa-hiking"></i></div>
      <p>Hiking</p>
    </div>

    <div class="filter">
      <div><i class="fa-solid fa-city"></i></div>
      <p>City Breaks</p>
    </div>

    <div class="filter">
      <div><i class="fa-solid fa-snowboarding"></i></div>
      <p>Skiing</p>
    </div>

    <!-- <div class="filter">
      <div><i class="fa-solid fa-heart"></i></div>
      <p>Romantic</p>
    </div> -->

    <div class="filter">
      <div><i class="fa-solid fa-users"></i></div>
      <p>Family</p>
    </div>

    <div class="filter">
      <div><i class="fa-solid fa-briefcase"></i></div>
      <p>Business</p>
    </div>

    <div class="filter">
      <div><i class="fa-solid fa-landmark"></i></div>
      <p>Historic</p>
    </div>

    <!-- <div class="filter">
      <div><i class="fa-solid fa-music"></i></div>
      <p>Nightlife</p>
    </div> -->
  </div>
  <button class="filter-arrow right" aria-label="Scroll filters right"><i class="fa-solid fa-chevron-right"></i></button>

  <div class="tax-toggle">
    <div class="form-switch form-check-reverse">
    <input class="form-check-input"  type="checkbox" role="switch" id="switchCheckDefault">
    <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
</div>
  </div>
</div>


<div class="row row-cols-lg-3 row-cols-mid-2 row-cols-sm-1 mt-3">
<% for(listing of allListings){ %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
<div class="card col listing-card" style="width: 20rem;">
  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 12rem">
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text">
      <b><%= listing.title %> </b> <br />
      &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
      <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
    </p>
  </div>
</div>
</a>
<% } %>
</div>

